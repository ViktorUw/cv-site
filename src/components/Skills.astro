---
interface Props {
	groups: { id: string; title: string; items: string[] }[];
}
const { groups } = Astro.props;
---

<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
	{
		groups.map((group) => (
			<div>
				<h3 class="border-b border-line pb-3 font-semibold">{group.title}</h3>
				<ul class="mt-4 space-y-2 text-muted">
					{group.items.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</div>
		))
	}
</div>
