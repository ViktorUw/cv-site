---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
	label: string;
}
const { lang, label } = Astro.props;
const names: Record<Lang, string> = { en: 'English', pl: 'Polski' };
---

<nav aria-label={label}>
	<ul class="flex items-center text-sm">
		{
			languages.map((code) => (
				<li>
					<a
						href={getRelativeLocaleUrl(code)}
						hreflang={code}
						lang={code}
						title={names[code]}
						aria-current={code === lang ? 'page' : undefined}
						class:list={[
							'block rounded-md px-2 py-1.5 font-medium transition-colors',
							code === lang ? 'text-ink' : 'text-muted hover:text-ink',
						]}
					>
						{code.toUpperCase()}
					</a>
				</li>
			))
		}
	</ul>
</nav>
