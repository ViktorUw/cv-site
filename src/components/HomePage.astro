---
// The whole one-page site. src/pages/index.astro and src/pages/pl/index.astro
// render it with their language.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';
import About from './About.astro';
import Process from './Process.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Education from './Education.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { getContacts, getList, getProfile, getProjects, getUi, type Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const [profile, ui, flow, steps, projects, skills, education, contacts] = await Promise.all([
	getProfile(lang),
	getUi(lang),
	getList('flow', lang),
	getList('process', lang),
	getProjects(lang),
	getList('skills', lang),
	getList('education', lang),
	getContacts(),
]);
const projectLabels = {
	...ui.projectLinks,
	planned: ui.plannedBadge,
	stack: ui.stackLabel,
};
---

<BaseLayout lang={lang} title={profile.seoTitle} description={profile.seoDescription}>
	<a
		href="#main"
		class="sr-only rounded-md bg-ink px-4 py-2 text-bg focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
	>
		{ui.skipToContent}
	</a>

	<Header lang={lang} name={profile.name} ui={ui} />

	<main id="main" class="mx-auto max-w-page px-5 sm:px-8">
		<Hero
			name={profile.name}
			role={profile.role}
			headline={profile.headline}
			intro={profile.intro}
			photo={profile.photo}
			photoAlt={profile.photoAlt}
			cta={ui.heroCta}
			flowCaption={ui.flowCaption}
			flow={flow}
		/>

		<!-- The rail: one line running through every section -->
		<div class="border-l border-line pl-(--rail-gap) [--rail-gap:--spacing(6)] sm:[--rail-gap:--spacing(12)]">
			<Section id="about" title={ui.sections.about}>
				<About paragraphs={profile.about} />
			</Section>

			<Section id="process" title={ui.sections.process}>
				<Process steps={steps} />
			</Section>

			<Section id="projects" title={ui.sections.projects}>
				<Projects projects={projects} labels={projectLabels} />
			</Section>

			<Section id="skills" title={ui.sections.skills}>
				<Skills groups={skills} />
			</Section>

			<Section id="education" title={ui.sections.education}>
				<Education entries={education} />
			</Section>

			<Section id="contact" title={ui.sections.contact}>
				<Contact
					intro={ui.contactIntro}
					contacts={contacts}
					kindLabels={ui.contactKinds}
					cvUrl={profile.cvUrl}
					cvLabel={ui.downloadCv}
				/>
			</Section>
		</div>
	</main>

	<Footer name={profile.name} note={ui.footer} />
</BaseLayout>
